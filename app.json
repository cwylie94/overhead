{
  "expo": {
    "name": "Overhead",
    "slug": "overhead",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "overhead",
    "userInterfaceStyle": "dark",
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "com.craigwylie.overhead",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Overhead shows the camera behind the crosshair in Catch mode, so you can see the satellite and the Moon on screen."
      }
    },
    "android": {
      "package": "com.craigwylie.overhead",
      "adaptiveIcon": {
        "backgroundColor": "#05070D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05070D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Overhead uses your location to work out which satellites pass over you and where to look.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Overhead uses motion to work out which part of the sky your phone is pointing at."
        }
      ],
      [
        "expo-dev-client",
        {
          "toolsButton": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
