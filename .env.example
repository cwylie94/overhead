# Base URL of the sync Worker. Leave unset to keep sightings on the device only.
# Locally: run `npm run dev` in server/ and use http://127.0.0.1:8787.
EXPO_PUBLIC_SYNC_URL=

# Apple team that signs builds for a real iPhone (Xcode > Settings > Accounts).
# Only needed for `npm run ios:device`.
APPLE_TEAM_ID=

# Use a fixed latitude,longitude instead of GPS, for testing passes from somewhere else.
# Leave empty for normal use.
EXPO_PUBLIC_TEST_LOCATION=
